#!/usr/bin/env bash

# imn -- run one operation on every IMN station over ssh.
#
# Stations are read from ~/.config/IMN/stations (override with $IMN_STATIONS):
# a TAB separated table of
#
#     <ip>	<station>	<user>
#
# Blank lines and lines starting with # are ignored. The station's ssh password
# is its station name, i.e. the second field. That file therefore holds
# credentials -- keep it out of the repo and chmod 600.
#
# Usage:
#     imn --test  [station ...]    pwd + ls on each station, to check reachability
#     imn --log   [station ...]    fetch the log of the station's last night
#     imn --clone [station ...]    git clone the IMN repo alongside RMS, and
#                                  repoint the station's external_script_path
#     imn --pull  [station ...]    git pull the station's IMN checkout
#
# --clone and --pull install requirements-bolides.txt into the station's ~/vRMS
# when it is not already importable.
#
# --clone and --pull also push the station's share of ~/.config/IMN, so a
# station ends up with the credentials and settings the nightly job needs. Only
# youtube.json and config.toml are sent, and config.toml only if it exists --
# every tunable in it has a built-in default. NOT client_secret.json, which is
# only needed where 'youtube.py authorize' is run, and emphatically NOT the
# stations file, which holds every station's password -- copying that to a
# station would hand one station the credentials of the whole fleet.
#
# With no station arguments every station in the file is visited. Otherwise only
# the ones whose station name or ip matches an argument. Stations are visited in
# file order and one failure does not stop the rest; the exit status is the
# number of stations that failed.

set -uo pipefail

readonly PROGNAME=${0##*/}
readonly CONFIG_DIR=${HOME}/.config/IMN
readonly STATIONS_FILE=${IMN_STATIONS:-${CONFIG_DIR}/stations}
readonly REPO_URL=https://github.com/blumzi/IMN.git

# The only files a station needs from ~/.config/IMN. Deliberately a whitelist:
# that directory also holds client_secret.json and the stations file, neither of
# which has any business on a station.
readonly CONFIG_FILES=(youtube.json config.toml)

# Of those, the ones a station can do without. config.toml is all tunables and
# every key has a built-in default, so its absence is normal rather than a
# failure; youtube.json is not optional, since without it nothing can upload.
readonly OPTIONAL_CONFIG_FILES=(config.toml)

# Where --log drops what it fetches.
readonly LOG_DIR=${IMN_LOG_DIR:-./imn-logs}

# Where IMN lives on a station: a sibling of RMS, both under ~/source.
readonly PARENT_DIR='${HOME}/source'
readonly CHECKOUT_DIR="${PARENT_DIR}/IMN"
readonly RMS_CONFIG="${PARENT_DIR}/RMS/.config"

# The venv RMS itself runs in, and so the one rmsExternal imports from.
readonly VENV='${HOME}/vRMS'
readonly REQUIREMENTS="${CHECKOUT_DIR}/requirements-bolides.txt"

readonly SSH_OPTS=(
    -o StrictHostKeyChecking=accept-new
    -o UserKnownHostsFile="${HOME}/.ssh/known_hosts"
    -o ConnectTimeout=5
    -o LogLevel=ERROR
)


usage() {
    # The header comment IS the usage text; print it all rather than a line
    # range that silently goes stale as the header grows.
    awk 'NR>2 && /^#/ { sub(/^# ?/, ""); print; next } NR>2 { exit }' "$0"
    exit "${1:-2}"
}


die() {
    echo "${PROGNAME}: $*" >&2
    exit 2
}


# The stations table with comments and blank lines taken out, so the reader
# below only ever sees real rows. In order: drop a CR from a file saved with
# Windows line endings (it would otherwise ride along in the last field and
# every ssh would get a bad username), cut from any # to end of line, drop the
# whitespace that leaves behind, then drop lines that are now empty.
strip_comments() {
    sed -e 's/\r$//' -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^[[:space:]]*$/d' "$1"
}


# Install the bolide feature's Python dependencies into the station's RMS venv,
# skipping the work when they import cleanly -- pip over the network is slow on
# a Pi and this runs on every clone and pull.
#
# Emitted into the mode scripts below via command substitution, whose output is
# inserted literally, so the \$ escapes here survive to the station.
install_deps_snippet() {
    cat <<EOF
if [ ! -x ${VENV}/bin/python ]; then
    echo "no venv at ${VENV} -- bolide dependencies not installed" >&2
elif [ ! -f ${REQUIREMENTS} ]; then
    echo "no ${REQUIREMENTS} -- bolide dependencies not installed" >&2
elif ${VENV}/bin/python -c 'import googleapiclient, google.oauth2, google_auth_oauthlib, importlib.util; assert any(importlib.util.find_spec(m) for m in ("tomllib", "tomli", "toml"))' 2>/dev/null; then
    echo "bolide dependencies already installed"
else
    echo "installing bolide dependencies ..."
    ${VENV}/bin/pip install --quiet -r ${REQUIREMENTS}
    echo "installed"
fi
EOF
}


# The remote command for each mode. Quoted with single quotes so ${HOME} is
# expanded on the station, not here.
remote_command() {
    case $1 in
    test)
        echo 'echo "host: $(hostname)"; pwd; ls'
        ;;
    clone)
        # Idempotent: a station that already has a checkout, or whose config
        # already points at it, is left alone rather than failing, so --clone
        # can be re-run over the whole fleet.
        #
        # RMS calls IMN through external_script_path in the station's .config,
        # and on the older stations that still points into ~/source/RMS/IMN.
        # Repoint it at the new sibling checkout, or the clone changes nothing
        # about what actually runs at the end of a night.
        cat <<EOF
set -e

mkdir -p ${PARENT_DIR}
if [ -d ${CHECKOUT_DIR}/.git ]; then
    echo "already cloned at ${CHECKOUT_DIR}"
else
    git clone ${REPO_URL} ${CHECKOUT_DIR}
fi

$(install_deps_snippet)

config=${RMS_CONFIG}
target=${CHECKOUT_DIR}/IMN.py

if [ ! -f "\$config" ]; then
    echo "no RMS config at \$config -- external_script_path not touched" >&2
    exit 1
fi

current=\$(sed -n 's/^external_script_path:[[:space:]]*//p' "\$config" | head -1)

if [ -z "\$current" ]; then
    echo "no external_script_path in \$config -- not touched" >&2
    exit 1
elif [ "\$current" = "\$target" ]; then
    echo "external_script_path already \$target"
else
    # -n keeps the first backup taken, so re-running never overwrites the
    # station's original config with an already-modified one.
    cp -n "\$config" "\$config.imn-backup"
    sed -i "s|^external_script_path:.*|external_script_path: \$target|" "\$config"
    echo "external_script_path: \$current -> \$target"
fi

# Without this RMS strips every log handler off the external script's process
# (RunExternalScript.externalFunctionWrapper), so the nightly hook's own lines
# go nowhere and a night's work leaves no trace in the log. RMS defaults it to
# false, and configs written before the option existed have no such key at all.
if grep -q "^external_script_log:[[:space:]]*true" "\$config"; then
    echo "external_script_log already true"
elif grep -q "^external_script_log:" "\$config"; then
    cp -n "\$config" "\$config.imn-backup"
    sed -i "s|^external_script_log:.*|external_script_log: true|" "\$config"
    echo "external_script_log -> true"
else
    cp -n "\$config" "\$config.imn-backup"
    # Insert rather than append: the config is sectioned, and the key has to
    # land in the same section as the other external_script_* settings.
    sed -i "/^external_function_name:/a external_script_log: true" "\$config"
    echo "external_script_log: added, true"
fi
EOF
        ;;
    pull)
        cat <<EOF
set -e
if [ ! -d ${CHECKOUT_DIR}/.git ]; then
    echo "no checkout at ${CHECKOUT_DIR} -- run '${PROGNAME} --clone' first" >&2
    exit 1
fi
cd ${CHECKOUT_DIR}
git pull --ff-only

$(install_deps_snippet)
EOF
        ;;
    esac
}


# Run one command on a station. The password goes through the environment, never
# argv, so it does not show up in ps output on this machine.
run_remote() {
    local ip=$1 station=$2 user=$3 command=$4

    SSHPASS="${station}" sshpass -e ssh "${SSH_OPTS[@]}" "${user}@${ip}" "${command}"
}


is_optional_config() {
    local name candidate
    name=$1
    for candidate in "${OPTIONAL_CONFIG_FILES[@]}"; do
        [ "${candidate}" = "${name}" ] && return 0
    done
    return 1
}


# Send CONFIG_FILES to the station's own ~/.config/IMN. Piped over ssh rather
# than scp'd so the file lands with 0600 in the same step -- these are
# credentials and must never sit world readable, however briefly.
copy_config() {
    local ip=$1 station=$2 user=$3
    local file path failed=0

    for file in "${CONFIG_FILES[@]}"; do
        path=${CONFIG_DIR}/${file}

        if [ ! -r "${path}" ]; then
            if is_optional_config "${file}"; then
                echo "no ${file} here; station keeps its defaults"
            else
                echo "${PROGNAME}: no ${path} to copy" >&2
                failed=1
            fi
            continue
        fi

        if run_remote "${ip}" "${station}" "${user}" \
            "mkdir -p ~/.config/IMN && umask 077 && cat > ~/.config/IMN/${file}" \
            < "${path}"
        then
            echo "sent ${file}"
        else
            echo "${PROGNAME}: could not send ${file} to ${station}" >&2
            failed=1
        fi
    done

    return "${failed}"
}


# Bring back the log of the station's last night of processing.
#
# Not simply the newest log: RMS opens a fresh one when it restarts, so right
# after a night's reboot the newest file is an idle session and the night's work
# is in the one before it. The wanted log is the newest that RMS actually ran the
# external script in, which is the marker RunExternalScript logs.
#
# Logs run to ~9MB, so it comes back gzipped over the wire.
fetch_log() {
    local ip=$1 station=$2 user=$3
    local remote_log

    remote_log=$(run_remote "${ip}" "${station}" "${user}" '
        for f in $(ls -t ~/RMS_data/logs/log_*.log 2>/dev/null | head -5); do
            if grep -q "Starting function" "$f"; then echo "$f"; exit 0; fi
        done
        ls -t ~/RMS_data/logs/log_*.log 2>/dev/null | head -1
    ' </dev/null) || return 1

    if [ -z "${remote_log}" ]; then
        echo "${PROGNAME}: no logs found on ${station}" >&2
        return 1
    fi

    mkdir -p "${LOG_DIR}"
    local local_log="${LOG_DIR}/${station}_${remote_log##*/}"

    run_remote "${ip}" "${station}" "${user}" "gzip -c '${remote_log}'" </dev/null \
        | gunzip > "${local_log}" || return 1

    echo "${remote_log} -> ${local_log} ($(wc -c <"${local_log}" | tr -d ' ') bytes)"

    # The nightly hook's own lines are the point of fetching this, so surface
    # them rather than making the reader open a 9MB file to find three lines.
    local hook
    hook=$(grep -E 'RunExternalScript|IMN\.bolides|IMN\.youtube|IMN:' "${local_log}" | tail -12)
    if [ -n "${hook}" ]; then
        echo "${hook}" | sed 's/^/    /'
    else
        echo "    (no external-script activity in this log)"
    fi
}


# Visit one station: the mode's command, plus the config files for the modes
# that deploy. --test only looks around, so it sends nothing.
run_on_station() {
    local ip=$1 station=$2 user=$3 user_command=$4 mode=$5
    local status=0

    echo "=== ${station} (${user}@${ip}) ==="

    if [ "${mode}" = log ]; then
        fetch_log "${ip}" "${station}" "${user}"
        return
    fi

    if [ "${mode}" != test ]; then
        copy_config "${ip}" "${station}" "${user}" || status=1
    fi

    # </dev/null so the remote command cannot swallow the caller's stdin.
    run_remote "${ip}" "${station}" "${user}" "${user_command}" </dev/null || status=1

    return "${status}"
}


main() {
    local mode=

    while (( $# )); do
        case $1 in
        --test)   mode=test;  shift ;;
        --log)    mode=log;   shift ;;
        --clone)  mode=clone; shift ;;
        --pull)   mode=pull;  shift ;;
        -h|--help) usage 0 ;;
        --) shift; break ;;
        -*) die "unknown option '$1' (try --help)" ;;
        *)  break ;;
        esac
    done

    [ -n "${mode}" ] || die "one of --test, --log, --clone or --pull is required"
    [ -r "${STATIONS_FILE}" ] || die "cannot read ${STATIONS_FILE}"
    command -v sshpass >/dev/null || die "sshpass is not installed"

    local wanted=("$@")
    local command failures=0 visited=0
    command=$(remote_command "${mode}")

    # The table is read on fd 3, not stdin: ssh drains its stdin, so a loop fed
    # from stdin would lose every station after the first.
    local ip station user
    while IFS=$'\t' read -r -u 3 ip station user _; do

        [ -n "${ip}" ] && [ -n "${station}" ] && [ -n "${user}" ] || {
            echo "${PROGNAME}: ignoring malformed line: ${ip}" >&2
            continue
        }

        if (( ${#wanted[@]} )); then
            local match= want
            for want in "${wanted[@]}"; do
                [ "${want}" = "${station}" ] || [ "${want}" = "${ip}" ] && match=yes
            done
            [ -n "${match}" ] || continue
        fi

        (( visited++ ))
        run_on_station "${ip}" "${station}" "${user}" "${command}" "${mode}" || {
            echo "${PROGNAME}: ${station} failed (exit $?)" >&2
            (( failures++ ))
        }
        echo

    done 3< <(strip_comments "${STATIONS_FILE}")

    if (( ! visited )); then
        die "no stations matched"
    fi

    echo "${visited} station(s) visited, ${failures} failed"
    return "${failures}"
}


main "$@"
