  "_comment": "Copy to ~/.config/IMN/youtube.json on the station. NEVER commit the real file. See youtube.py for how to obtain the refresh_token (python youtube.py authorize).",
  "client_id": "REPLACE.apps.googleusercontent.com",
  "client_secret": "REPLACE",
  "refresh_token": "REPLACE",
  "_comment_playlists": "Playlist titles are templates. {station} plus, from the capture night, {night} {month} {year}; track stacks also get {shower}. Omit these two keys entirely to keep the old single flat playlist per station. A fixed playlist_id, if you add one, overrides both.",
  "playlist_title": "IMN/{station}/{month}",
  "trackstack_playlist_title": "IMN/{station}/{shower}-{year}",
  "playlist_privacy": "public",
  "privacy": "unlisted"
}
